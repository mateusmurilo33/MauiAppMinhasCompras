<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiAppMinhasCompras.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MauiAppMinhasCompras.Views"
    Title="MauiAppMinhasCompras">

    <FlyoutItem Title="Novo Produto">
        <ShellContent
            Title="Novo Produto"
            ContentTemplate="{DataTemplate views:NovoProduto}"
            Route="NovoProduto" />
    </FlyoutItem>

    <FlyoutItem Title="Meus Produtos">
        <ShellContent
            Title="Meus Produtos"
            ContentTemplate="{DataTemplate views:ListaProduto}"
            Route="ListaProduto" />
    </FlyoutItem>

</Shell>