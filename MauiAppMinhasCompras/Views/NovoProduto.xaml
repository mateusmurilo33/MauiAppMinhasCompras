<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.NovoProduto"
             Title="Novo Produto">

    <VerticalStackLayout
        Padding="30"
        Spacing="15">

        <Label
            Text="Cadastro de Produto"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Entry
            x:Name="txt_descricao"
            Placeholder="Descrição do produto" />

        <Entry
            x:Name="txt_quantidade"
            Placeholder="Quantidade"
            Keyboard="Numeric" />

        <Entry
            x:Name="txt_preco"
            Placeholder="Preço"
            Keyboard="Numeric" />

        <Button
            Text="Salvar Produto"
            Clicked="OnSalvarClicked" />

    </VerticalStackLayout>

</ContentPage>